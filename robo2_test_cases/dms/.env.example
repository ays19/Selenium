# Copy this file to dms/.env and fill in valid credentials and local paths.
# Shared across all 3 test sheets: DMS, Report, and Configurable.

# =============================================================================
# SHARED ENVIRONMENT & CREDENTIALS (DMS, Report, Configurable)
# =============================================================================
BASE_URL=https://ecmv6.robo2mation.com
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password
GENERAL_USERNAME=your_general_username
GENERAL_PASSWORD=your_general_password

EXCEL_PATH=robo2_test_cases/Robo2mation_26Q1_Sanity_Test_Case_Doc.xlsx
TESTER_NAME=Your Name
SCREENSHOT_DIR=screenshots
DOWNLOAD_DIR=downloads
ALLURE_RESULTS_DIR=allure-results
EVIDENCE_LINK=
EVIDENCE_HEADER=Remarks
HEADLESS=false

# =============================================================================
# DMS SUITE
# =============================================================================
DMS_SHEET_NAME=DMS
SAMPLE_DIR=test_files

# Optional DMS account overrides (defaults to ADMIN_* and GENERAL_*)
# DMS_USERNAME=
# DMS_PASSWORD=
OTHER_USERNAME=second_general_user
OTHER_PASSWORD=second_user_password

SHARE_EMAIL=valid_mail@example.com
CHECKER_DOC_TYPE=
DOC_TYPE=/LMG DocType/
CHECKER_NAME=
NAME_CONVENTION_DOC_TYPE=
OCR_DOC_TYPE=
OCR_SEARCH_TEXT=
EXPLORER_DOC_TYPE=/1 MT Category/Retest OCR and File inconsistency/
OTHER_USER_VISIBLE_DOC_TYPE=
OTHER_USER_HIDDEN_DOC_TYPE=
BULK_DOC_TYPE=/DOC 1/
MTM_DOC_TYPE=
MTM_MASTER_TABLE=
MASTER_FILTER_DOC_TYPE=
MASTER_ASSIGN_DOC_TYPE=
CATEGORY_TO_UPDATE=
